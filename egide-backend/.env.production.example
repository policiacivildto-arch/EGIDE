# ===================================
# CONFIGURAÇÃO PARA PRODUÇÃO (RENDER + SUPABASE)
# ===================================

# Django
SECRET_KEY=sua-chave-secreta-super-segura-aqui-gere-uma-nova
DEBUG=False
ALLOWED_HOSTS=.onrender.com,seu-dominio.com

# Supabase PostgreSQL
# Pegue essas informações no painel do Supabase > Settings > Database
DATABASE_URL=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres.[SEU-PROJECT-REF]
POSTGRES_PASSWORD=sua-senha-do-supabase
POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
POSTGRES_PORT=6543

# CORS - Adicione seu domínio de produção
CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app,https://seu-app.onrender.com

# Email (SMTP para recuperação de senha)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=seu_email@dominio.com
EMAIL_HOST_PASSWORD=sua_senha_de_app
DEFAULT_FROM_EMAIL=EGIDE <seu_email@dominio.com>
EMAIL_TIMEOUT=10

# URL pública para montar link de redefinição
FRONTEND_URL=https://seu-frontend.vercel.app
RESET_PASSWORD_PATH=/reset-password

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
